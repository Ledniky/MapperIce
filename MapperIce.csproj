<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>mapperice.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="mapperice.ico" LogicalName="MapperIce.mapperice.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Репозиторий Goob-Station лежит внутри корня проекта и не должен компилироваться -->
    <Compile Remove="Goob-Station\**" />
    <EmbeddedResource Remove="Goob-Station\**" />
    <None Remove="Goob-Station\**" />
    <Content Remove="Goob-Station\**" />
    <Page Remove="Goob-Station\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>